{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "bun install",
  "buildCommand": "bun run build",
  "outputDirectory": "frontend/dist",
  "bunVersion": "1.x",
  "functions": {
    "api/generate-pdf.ts": {
      "includeFiles": "frontend/public/**"
    },
    "api/download-as-image.ts": {
      "includeFiles": "frontend/public/**"
    }
  },
  "rewrites": [
    {
      "source": "/view/:id",
      "destination": "/index.html"
    }
  ]
}
